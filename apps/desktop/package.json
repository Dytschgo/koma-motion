{
  "name": "@koma-motion/desktop",
  "productName": "Koma Motion",
  "version": "0.1.0",
  "private": true,
  "description": "Presentations are frames. Make them move.",
  "author": "Koma Motion contributors",
  "homepage": "https://github.com/Dytschgo/koma-motion",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dytschgo/koma-motion.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "icon": "node scripts/run-electron.mjs scripts/generate-icon.cjs",
    "package:win": "node scripts/build.mjs && electron-builder --win --publish never",
    "package:mac": "node scripts/build.mjs && electron-builder --mac --universal --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:packaged": "playwright test --config playwright.packaged.config.ts"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@koma-motion/agent-runtime": "workspace:*",
    "@koma-motion/brand-kit": "workspace:*",
    "@koma-motion/core": "workspace:*",
    "@koma-motion/exporters": "workspace:*",
    "@koma-motion/motion-engine": "workspace:*",
    "@koma-motion/project-format": "workspace:*",
    "@koma-motion/renderer": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-updater": "6.8.9",
    "fast-xml-parser": "^5.11.2",
    "image-size": "^2.0.4",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
