{
  "name": "@koma-motion/desktop",
  "productName": "Koma Motion",
  "version": "0.3.0",
  "private": true,
  "description": "Presentations are frames. Make them move.",
  "author": "Koma Motion contributors",
  "homepage": "https://github.com/Dytschgo/koma-motion",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dytschgo/koma-motion.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "icon": "node scripts/run-electron.mjs scripts/generate-icon.cjs",
    "package:win": "node scripts/build.mjs && electron-builder --win --publish never",
    "package:mac": "node scripts/build.mjs && electron-builder --mac --universal --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.integration.json",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:packaged": "playwright test --config playwright.packaged.config.ts"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@koma-motion/agent-runtime": "workspace:*",
    "@koma-motion/brand-kit": "workspace:*",
    "@koma-motion/core": "workspace:*",
    "@koma-motion/exporters": "workspace:*",
    "@koma-motion/motion-engine": "workspace:*",
    "@koma-motion/project-format": "workspace:*",
    "@koma-motion/renderer": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.18.0",
    "electron-updater": "6.8.11",
    "fast-xml-parser": "^5.12.0",
    "image-size": "^2.0.4",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
