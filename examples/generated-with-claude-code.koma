      {
        "id": "koma_c3a33901f266c194",
        "title": "The motion engine",
        "purpose": "Move in on the motion engine and explain how it creates motion.",
        "speakerNotes": "The motion engine looks at two Komas and matches objects by their persistent ID. When an object appears in both, the engine works out the change: it moves, scales, rotates, fades or changes colour. You never draw a single keyframe.",
        "background": {
          "type": "solid",
          "colour": "#182033"
        },
