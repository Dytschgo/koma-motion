  "presentation": {
    "id": "presentation_55fad3861680178e",
    "title": "Koma Motion",
    "objective": "Introduce Koma Motion: show the whole system first, then the motion engine, then show that the result stays editable.",
    "audience": "General audience new to Koma Motion.",
    "narrative": "We begin with the whole pipeline: Komas go into the motion engine, and an editable result comes out. The camera then moves in on the motion engine and explains how it finds motion by matching persistent objects. Finally, the attention moves to the output: the animation is still made of real objects that can be changed at any time.",
    "aspectRatio": "16:9",
    "komas": [
      {
        "id": "koma_4f01a3d926f31d43",
        "title": "The complete system",
        "purpose": "Show the whole pipeline in one view: Komas, the motion engine and the editable result.",
        "speakerNotes": "Koma Motion has three parts. You design Komas, which are visual states. The motion engine works out the animation between them. What you get back is a presentation you can still edit.",
        "background": {
          "type": "solid",
          "colour": "#182033"
        },
