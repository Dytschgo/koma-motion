  "name": "Rapunzel story",
  "createdAt": "2026-10-01T20:00:01.117Z",
  "updatedAt": "2026-10-01T20:09:14.807Z",
  "brandKit": {
    "name": "Golden Tower Tales",
    "colours": {
      "primary": "#F2B33D",
      "secondary": "#6D4AA8",
      "accent": "#F28CB1",
      "background": "#1B1530",
      "text": "#FBF4E6"
    },
    "typography": {
      "headingFont": "Palatino Linotype, Palatino, Book Antiqua, Georgia",
      "bodyFont": "Georgia, Palatino Linotype, serif"
    },
    "logoAssetId": null,
    "tone": "Warm storyteller voice, like reading aloud at bedtime. Simple sentences, gentle suspense, a happy ending.",
    "visualStyle": "Storybook theatre at dusk. Deep violet night sky, golden hair and lantern light, rose highlights, soft rounded shapes, layered silhouettes for hills and trees, scenes that feel like paper cut-outs on a stage.",
    "iconStyle": "Soft rounded paper cut-out shapes.",
    "preferredImagery": "Scenes built from layered shapes: a tall stone tower, a tiny window, a long golden braid, moon and stars, rolling hills, round trees, floating lanterns.",
    "preferredTopics": [
      "fairy tale",
      "Rapunzel",
      "storytelling",
      "courage",
      "freedom"
    ],
    "referenceNotes": "Retell the classic Brothers Grimm tale in a gentle, child-friendly way (no violence). Scene palette hints: tower stone #8A7FA8 and #5E537D, forest #2F6B4F and #24533D, moon #FFF3C4, lantern glow #FFB347."
  },
  "presentation": {
    "id": "presentation_ec7ea4c93ea15b10",
    "title": "Rapunzel – An Animated Storybook",
    "objective": "Retell Rapunzel as a gentle animated picture book in which one persistent stage and a golden braid carry the story.",
    "audience": "Families and children at bedtime",
    "narrative": "At dusk a lonely tower stands beyond the hills. The camera moves in to find a hidden girl with golden hair. The camera pulls back as Gothel calls and the braid grows to the ground. A prince hears her song and climbs. Clever Gothel cuts the braid and sends Rapunzel away. The camera pans into a wild forest as the prince searches. At a rose dawn, lanterns rise and the braid becomes a golden ribbon over the two of them.",
    "aspectRatio": "16:9",
